  m_Script: {fileID: 11500000, guid: a56d950c01a6274438f8999a8bf6fb6c, type: 3}
  m_Name: Design_AP-01
  m_EditorClassIdentifier: Fatiro.Runtime::Fatiro.Content.HouseDesign
  designId: AP-01
  version: 1
  displayName: Amacumbi
  meaning: flats
  description: 'A three-storey block of four flats: a reinforced-concrete frame with
    fired-brick walls, a concrete stair and open parking on the ground floor.'
  lesson: 'An open ground floor is a soft storey: in an earthquake its columns take
    all the sway. Shear walls stiffen it.'
  difficulty: 3
  accentColor: {r: 0.35, g: 0.6, b: 0.9, a: 1}
  sortOrder: 5
  foundationName: Pad footings
  foundationInspiration: Reinforced-concrete pads under every column
  foundationBearing: 1.3
  foundationSlopeResistance: 0.6
  foundationGrip: 1.1
  uphillReferenceZ: -4
  members:
