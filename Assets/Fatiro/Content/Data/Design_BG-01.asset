  m_Name: Design_BG-01
  m_EditorClassIdentifier: Fatiro.Runtime::Fatiro.Content.HouseDesign
  designId: BG-01
  version: 1
  displayName: Urugo
  meaning: home
  description: 'A single-storey family home: a concrete frame with fired-brick walls
    on a stepped brick foundation, and an iron-sheet roof over two bedrooms and a
    living room.'
  lesson: Light iron-sheet roofs are lifted off by strong wind unless storm straps
    tie them down to the walls.
  difficulty: 1
  accentColor: {r: 0.3, g: 0.7, b: 0.45, a: 1}
  sortOrder: 3
  foundationName: Pad footings
  foundationInspiration: Reinforced-concrete pads under every column
  foundationBearing: 1.2
  foundationSlopeResistance: 0.6
  foundationGrip: 1.1
  uphillReferenceZ: -4
