  m_Script: {fileID: 11500000, guid: a56d950c01a6274438f8999a8bf6fb6c, type: 3}
  m_Name: Design_EL-01
  m_EditorClassIdentifier: Fatiro.Runtime::Fatiro.Content.HouseDesign
  designId: EL-01
  version: 2
  displayName: Inzovu
  meaning: elephant
  description: An elephant on four thick concrete legs. A home sits on its belly
    floor under a ferrocement dome; its ears shade the sides and its trunk carries
    rainwater to a cistern.
  lesson: Cantilevered canopies must be tied down against wind uplift, and roofs
    need drains sized for heavy rain.
  difficulty: 2
  accentColor: {r: 0.55, g: 0.62, b: 0.7, a: 1}
  sortOrder: 1
  foundationName: Elephant feet
  foundationInspiration: Wide soft pads spread a huge weight
  foundationBearing: 1.4
  foundationSlopeResistance: 0.2
  foundationGrip: 1
  uphillReferenceZ: -2.5
  members:
