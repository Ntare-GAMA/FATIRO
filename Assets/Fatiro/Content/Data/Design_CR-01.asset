  m_Name: Design_CR-01
  m_EditorClassIdentifier: Fatiro.Runtime::Fatiro.Content.HouseDesign
  designId: CR-01
  version: 1
  displayName: Imodoka
  meaning: car
  description: A sports-car pod lifted on raked spider stilts that step down the
    hillside.
  lesson: On a slope the downhill stilts are longest and buckle first; bracing and
    stronger material fix them.
  difficulty: 1
  accentColor: {r: 0.9, g: 0.25, b: 0.25, a: 1}
  sortOrder: 2
  foundationName: Spider feet
  foundationInspiration: Raked spider legs grip the slope
  foundationBearing: 1
  foundationSlopeResistance: 0.8
  foundationGrip: 1.2
  uphillReferenceZ: -3.5
  members:
