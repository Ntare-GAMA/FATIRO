  m_Script: {fileID: 11500000, guid: a56d950c01a6274438f8999a8bf6fb6c, type: 3}
  m_Name: Design_CR-01
  m_EditorClassIdentifier: Fatiro.Runtime::Fatiro.Content.HouseDesign
  designId: CR-01
  version: 2
  displayName: Imodoka
  meaning: car
  description: A house that is a sports car. Raked concrete stilts lift its ferrocement
    body off the hillside; behind the windscreen are a kitchen, a living room and
    a bedroom.
  lesson: On a slope the downhill stilts are longest and buckle first; bracing and
    stronger material fix them.
  difficulty: 1
  accentColor: {r: 0.9, g: 0.25, b: 0.25, a: 1}
  sortOrder: 2
  foundationName: Spider feet
  foundationInspiration: Raked spider legs grip the slope
  foundationBearing: 1
  foundationSlopeResistance: 0.8
  foundationGrip: 1.2
  uphillReferenceZ: -3.5
  members:
