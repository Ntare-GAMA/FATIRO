  m_Script: {fileID: 11500000, guid: a56d950c01a6274438f8999a8bf6fb6c, type: 3}
  m_Name: Design_TS-01
  m_EditorClassIdentifier: Fatiro.Runtime::Fatiro.Content.HouseDesign
  designId: TS-01
  version: 1
  displayName: Igorofa
  meaning: storey house
  description: 'A two-storey family house: a reinforced-concrete frame with fired-brick
    walls, a concrete stair, bedrooms upstairs, a clay-tile roof and a balcony over
    the valley.'
  lesson: 'A balcony is a cantilever: a crowd on it bends it hard, so it needs depth,
    strength or columns under it.'
  difficulty: 2
  accentColor: {r: 0.85, g: 0.55, b: 0.25, a: 1}
  sortOrder: 4
  foundationName: Pad footings
  foundationInspiration: Reinforced-concrete pads under every column
  foundationBearing: 1.2
  foundationSlopeResistance: 0.6
  foundationGrip: 1.1
  uphillReferenceZ: -3.5
  members:
