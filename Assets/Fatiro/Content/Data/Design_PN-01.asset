  m_Script: {fileID: 11500000, guid: a56d950c01a6274438f8999a8bf6fb6c, type: 3}
  m_Name: Design_PN-01
  m_EditorClassIdentifier: Fatiro.Runtime::Fatiro.Content.HouseDesign
  designId: PN-01
  version: 2
  displayName: Ingwe
  meaning: panther
  description: A black panther crouched down the hillside. Concrete rib arches carry
    its ferrocement body; floors step down inside; its raised head is a viewing room
    over the valley.
  lesson: Rib arches need bracing to resist shaking, and cantilevers need depth,
    strength or a prop.
  difficulty: 3
  accentColor: {r: 0.55, g: 0.35, b: 0.95, a: 1}
  sortOrder: 0
  foundationName: Paw strips
  foundationInspiration: Panther paws spread weight along the ground
  foundationBearing: 1.2
  foundationSlopeResistance: 0.4
  foundationGrip: 1.1
  uphillReferenceZ: -4
  members:
