  m_Name: Design_PN-01
  m_EditorClassIdentifier: Fatiro.Runtime::Fatiro.Content.HouseDesign
  designId: PN-01
  version: 1
  displayName: Ingwe
  meaning: panther
  description: A black panther crouched down the hillside. Six rib arches form its
    body; its head is a viewing room cantilevered over the slope.
  lesson: Rib arches need bracing to resist shaking, and cantilevers need depth,
    strength or a prop.
  difficulty: 3
  accentColor: {r: 0.55, g: 0.35, b: 0.95, a: 1}
  sortOrder: 0
  foundationName: Paw strips
  foundationInspiration: Panther paws spread weight along the ground
  foundationBearing: 1.2
  foundationSlopeResistance: 0.4
  foundationGrip: 1.1
  uphillReferenceZ: -4
  members:
